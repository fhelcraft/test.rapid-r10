---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'RAPID Growth Project, Region 10 | DTI Northern Mindanao',
	description = 'The DTI–IFAD RAPID Growth Project strengthens agro-enterprise development in rural communities of Northern Mindanao: coffee, cacao and coconut in Bukidnon and Misamis Oriental.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#062b2f" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Public+Sans:ital,wght@0,400..700;1,400..700&display=swap"
		/>
		<!-- Blackletter fallback for the footer's "Republic of the Philippines", subset to just those letters -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&text=Republic%20of%20the%20Philippines&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
