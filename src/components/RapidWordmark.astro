<style>
	.rapid-wordmark {
		display: inline-block;
		height: 0.74em;
		width: auto;
		overflow: visible;
	}
	.rapid-chevron {
		transform-box: fill-box;
		transform-origin: 0 50%;
		animation: chevron-in 1.2s var(--ease-out-quint) 0.55s both;
	}
	@keyframes chevron-in {
		from {
			opacity: 0;
			transform: translateX(-35%) scaleX(0.6);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.rapid-chevron {
			animation: none;
		}
	}
</style>
