---
import { Image } from 'astro:assets';
import { about, news } from '../data/rapid';

// Three field photos, layered in depth
const byId = (id: number) => news.find((n) => n.id === id)!;
const layers = [byId(140), byId(142), byId(146)];
---

<section id="about" class="relative bg-mist py-24 sm:py-36">
	<div class="shell grid items-center gap-16 lg:grid-cols-[1.05fr_1fr] lg:gap-24">
		<div>
			<p class="text-xl text-teal">Introducing the</p>
			<h2 class="display mt-1 text-[clamp(2.6rem,6.5vw,5.25rem)] text-teal">RAPID Growth Project</h2>
			<div class="mt-10 max-w-[36rem] space-y-5 text-lg text-ink/85">
				{about.paragraphs.map((p) => <p>{p}</p>)}
			</div>
			<a
				href={about.learnMore}
				target="_blank"
				rel="noopener"
				class="mt-9 inline-block font-semibold text-teal underline decoration-leaf decoration-2 underline-offset-[6px] hover:decoration-teal"
			>
				Learn more about the project on dtirapid.ph
			</a>
		</div>

		<div class="depth" data-depth aria-hidden="true">
			{
				layers.map((n, i) => (
					<div class={`depth-layer depth-${i}`}>
						<Image src={n.image} alt="" width={800} widths={[480, 800]} sizes="(min-width: 1024px) 30vw, 70vw" />
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.depth {
		position: relative;
		aspect-ratio: 1 / 1.05;
		perspective: 1100px;
		--rx: 0deg;
		--ry: 0deg;
	}
	.depth-layer {
		position: absolute;
		overflow: hidden;
		border-radius: 6px;
		box-shadow: 0 30px 60px -25px rgb(3 26 29 / 0.55);
		transform-style: preserve-3d;
		transition: transform 0.9s var(--ease-out-quint);
	}
	.depth-layer img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.depth-0 img {
		object-position: 50% 90%;
	}
	.depth-0 {
		inset: 0 22% 30% 0;
		transform: rotateX(var(--rx)) rotateY(var(--ry)) translateZ(0);
	}
	.depth-1 {
		inset: 38% 0 6% 34%;
		transform: rotateX(var(--rx)) rotateY(var(--ry)) translateZ(70px);
	}
	.depth-2 {
		inset: 62% 46% 0 8%;
		border: 6px solid var(--color-mist);
		transform: rotateX(var(--rx)) rotateY(var(--ry)) translateZ(130px);
	}
</style>

<script>
	const el = document.querySelector<HTMLElement>('[data-depth]');
	const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (el && !still) {
		el.parentElement?.addEventListener('pointermove', (e) => {
			const r = el.getBoundingClientRect();
			const x = (e.clientX - (r.left + r.width / 2)) / r.width;
			const y = (e.clientY - (r.top + r.height / 2)) / r.height;
			el.style.setProperty('--ry', `${x * 10}deg`);
			el.style.setProperty('--rx', `${-y * 8}deg`);
		});
		el.parentElement?.addEventListener('pointerleave', () => {
			el.style.setProperty('--ry', '0deg');
			el.style.setProperty('--rx', '0deg');
		});
	}
</script>
