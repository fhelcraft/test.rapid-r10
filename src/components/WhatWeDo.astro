---
import { components } from '../data/rapid';
---

<section id="what" class="bg-mist py-24 sm:py-32">
	<div class="shell grid gap-12 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-20">
		<div>
			<h2 class="display text-[clamp(2.2rem,4.5vw,3.6rem)] text-teal">What the project does</h2>
			<p class="mt-6 max-w-sm text-ink/75">Three components, working together on the same farms and enterprises.</p>
		</div>
		<ul class="divide-y divide-teal/15 border-y border-teal/15">
			{
				components.map((c) => (
					<li>
						<a href={c.href} target="_blank" rel="noopener" class="row group grid gap-3 py-9 sm:grid-cols-[1.1fr_1fr] sm:gap-10">
							<h3 class="display text-[clamp(1.6rem,2.6vw,2.2rem)] text-teal transition-colors group-hover:text-leaf">{c.name}</h3>
							<div>
								<p class="text-ink/80">{c.body}</p>
								<p class="mt-3 font-semibold text-teal">{c.figure}</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
